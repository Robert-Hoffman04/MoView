<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-screen Downloads activity.

    Layout:
    - Entire screen uses standardBackground.
    - Large "Current Download" card on the left (about 2/3 width).
    - Right column contains:
        1. Queue summary card
        2. Scrollable list card for pending downloads
    - Designed for TV / 10-foot UI with large typography and generous spacing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/standardBackground"
    android:padding="32dp"
    android:weightSum="3">

    <!-- ========================================================= -->
    <!-- LEFT SIDE: Current Download                               -->
    <!-- ========================================================= -->
    <androidx.cardview.widget.CardView
        android:id="@+id/currentDownloadCard"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="@color/sidePanel"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="32dp">

            <!-- Section title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Download"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:alpha="0.75" />

            <!-- Active title -->
            <TextView
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No active download."
                android:textColor="@color/white"
                android:textSize="34sp"
                android:textStyle="bold" />

            <!-- Metadata -->
            <TextView
                android:id="@+id/textProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Waiting for jobs..."
                android:textColor="@color/white"
                android:textSize="18sp"
                android:alpha="0.75" />

            <!-- Download progress label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="8dp"
                android:text="Download Progress"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:alpha="0.85" />

            <!-- Download progress -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:max="100"
                android:progress="0" />

            <!-- Encoding progress label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:text="Encoding Progress"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:alpha="0.85" />

            <!-- Encoding progress -->
            <ProgressBar
                android:id="@+id/encodeProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:max="100"
                android:progress="0" />

            <!-- Flexible spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Optional large status/log area -->
            <TextView
                android:id="@+id/currentStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:alpha="0.6" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ========================================================= -->
    <!-- RIGHT SIDE: Queue                                         -->
    <!-- ========================================================= -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Queue Summary Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/queueSummaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/sidePanel"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Queue"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:alpha="0.75" />

                <TextView
                    android:id="@+id/queueCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 pending"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Queue List Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/queueListCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/sidePanel"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <!-- Container for dynamically-added queue items -->
                <LinearLayout
                    android:id="@+id/outputBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Placeholder -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Queue is empty."
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:alpha="0.6" />

                </LinearLayout>
            </ScrollView>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>