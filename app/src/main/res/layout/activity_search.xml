        android:id="@+id/searchBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"

        android:layout_marginHorizontal="10dp"
        android:layout_toEndOf="@id/backspace"
        android:ems="10"
        android:focusable="false"
        android:hint="@string/enter_search"
        android:inputType="text"
        android:textColor="@color/white"
        tools:ignore="Autofill,VisualLintTextFieldSize,TextContrastCheck" />

    <com.example.moview.IncrementalRecyclerView
        android:id="@+id/searchGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/searchBar"
        android:layout_marginHorizontal="10dp"
        android:layout_toEndOf="@id/keys"
